views:
  - type: table
    name: Vista
    filters:
      and:
        - file.ext != "base"
        - file.path.contains("references")
        - file.name != "index"
    order:
      - file.name
      - date
      - author
      - url
      - tags
      - doi
    sort:
      - property: contributors
        direction: ASC
