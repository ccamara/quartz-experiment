filters:
  and:
    - file.hasLink(this)
views:
  - type: cards
    name: Actions
    filters:
      and:
        - file.folder.contains("actions")
        - file.name != "index"
    order:
      - file.name
      - url
      - country
  - type: cards
    name: Organisations
    filters:
      and:
        - file.folder.contains("organisations")
        - file.name != "index"
    order:
      - file.name
