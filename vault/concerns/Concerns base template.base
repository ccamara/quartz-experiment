filters:
  and:
    - file.hasLink(this)
views:
  - type: cards
    name: Actions
    filters:
      and:
        - file.path.contains("actions/")
    order:
      - file.name
      - url
      - country
  - type: cards
    name: Organisations
    filters:
      and:
        - file.path.contains("organisations/")
